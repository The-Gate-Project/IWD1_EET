IF
	Global("MALAVON_DOOR","GLOBAL",0)
	!Global("MAP_GROUP_HOSTILE1","MYAREA",0)
THEN
	RESPONSE #100
		CloseDoor("AR8010HIDEME")
		TriggerActivation("To8009",FALSE)
		SetGlobal("MALAVON_DOOR","GLOBAL",1)
		Continue()
END

// Draiken fix: the exit used to reopen only if the hidden door was still closed.
// The door is flagged "can't close", so CloseDoor() can fail and the exit stayed
// disabled for good (party trapped in the dome). Reopen based on a variable instead.
IF
	OR(2)
		!Global("SPRITE_IS_DEADMALAVON","GLOBAL",0)
		!Global("MALAVON_BADGE","GLOBAL",0)
	Global("MALAVON_DOOR","GLOBAL",1)
THEN
	RESPONSE #100
		SetGlobal("MALAVON_DOOR","GLOBAL",2)
		OpenDoor("AR8010HIDEME")
		TriggerActivation("To8009",TRUE)
		Continue()
END

IF
	Global("MALAVON_BADGE","GLOBAL",0)
	PartyHasItem("MALAVON")
THEN
	RESPONSE #100
		SetGlobal("MALAVON_BADGE","GLOBAL",1)
		AddXP2DA("ID1EX11V")
		DisplayStringNoName(Player1,@19560)
		Continue()
END

IF
	OnCreation()
THEN
	RESPONSE #100
		NoAction()
		Continue()
END

